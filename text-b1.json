  "19": [
    {"en":"What's the matter, children?","cn":"孩子们，怎么啦？","speaker":"MOTHER","source":"textbook","pdfPage":41,"printedPage":37,"sourceFile":"电子资料/新概念英语第一册学生用书.pdf","verification":"verified","translationSource":"supplement"},
    {"en":"We're tired . . .","cn":"我们累了……","speaker":"GIRL","source":"textbook","pdfPage":41,"printedPage":37,"sourceFile":"电子资料/新概念英语第一册学生用书.pdf","verification":"verified","translationSource":"supplement"},
    {"en":". . . and thirsty, Mum.","cn":"……而且渴了，妈妈。","speaker":"BOY","source":"textbook","pdfPage":41,"printedPage":37,"sourceFile":"电子资料/新概念英语第一册学生用书.pdf","verification":"verified","translationSource":"supplement"},
    {"en":"Sit down here.","cn":"坐在这儿吧。","speaker":"MOTHER","source":"textbook","pdfPage":41,"printedPage":37,"sourceFile":"电子资料/新概念英语第一册学生用书.pdf","verification":"verified","translationSource":"supplement"},
    {"en":"Are you all right now?","cn":"你们现在好些了吗？","speaker":"MOTHER","source":"textbook","pdfPage":41,"printedPage":37,"sourceFile":"电子资料/新概念英语第一册学生用书.pdf","verification":"verified","translationSource":"supplement"},
    {"en":"No, we aren't.","cn":"不，还没有。","speaker":"BOY","source":"textbook","pdfPage":41,"printedPage":37,"sourceFile":"电子资料/新概念英语第一册学生用书.pdf","verification":"verified","translationSource":"supplement"},
    {"en":"Look!","cn":"瞧！","speaker":"MOTHER","source":"textbook","pdfPage":41,"printedPage":37,"sourceFile":"电子资料/新概念英语第一册学生用书.pdf","verification":"verified","translationSource":"supplement"},
    {"en":"There's an ice cream man.","cn":"有个卖冰淇淋的。","speaker":"MOTHER","source":"textbook","pdfPage":41,"printedPage":37,"sourceFile":"电子资料/新概念英语第一册学生用书.pdf","verification":"verified","translationSource":"supplement"},
    {"en":"Two ice creams please.","cn":"请拿两个冰淇淋。","speaker":"MOTHER","source":"textbook","pdfPage":41,"printedPage":37,"sourceFile":"电子资料/新概念英语第一册学生用书.pdf","verification":"verified","translationSource":"supplement"},
    {"en":"Here you are, children.","cn":"拿着，孩子们。","speaker":"MOTHER","source":"textbook","pdfPage":41,"printedPage":37,"sourceFile":"电子资料/新概念英语第一册学生用书.pdf","verification":"verified","translationSource":"supplement"},
    {"en":"Thanks, Mum.","cn":"谢谢，妈妈。","speaker":"CHILDREN","source":"textbook","pdfPage":41,"printedPage":37,"sourceFile":"电子资料/新概念英语第一册学生用书.pdf","verification":"verified","translationSource":"supplement"},
    {"en":"These ice creams are nice.","cn":"这些冰淇淋真好吃。","speaker":"GIRL","source":"textbook","pdfPage":41,"printedPage":37,"sourceFile":"电子资料/新概念英语第一册学生用书.pdf","verification":"verified","translationSource":"supplement"},
    {"en":"Are you all right now?","cn":"你们现在好些了吗？","speaker":"MOTHER","source":"textbook","pdfPage":41,"printedPage":37,"sourceFile":"电子资料/新概念英语第一册学生用书.pdf","verification":"verified","translationSource":"supplement"},
    {"en":"Yes, we are, thank you!","cn":"是的，好些了，谢谢！","speaker":"CHILDREN","source":"textbook","pdfPage":41,"printedPage":37,"sourceFile":"电子资料/新概念英语第一册学生用书.pdf","verification":"verified","translationSource":"supplement"}
